{
  "name": "smartwallet",
  "version": "1.0.0",
  "description": "Offline-first personal finance tracker for Android: expenses, budgets, accounts and loans, stored locally.",
  "author": "Kiran Kumar V",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "apk": "expo prebuild -p android --no-install && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../SmartWallet.apk",
    "test": "tsx src/lib/money.test.ts && tsx src/lib/csv.test.ts && tsx src/lib/ledger.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
